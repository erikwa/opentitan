CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:systems:chip_darjeeling_asic:0.1"
description: "Darjeeling chip level"
vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_veriblelint:
    datatype: bool
    default: false
    description: Set when linting with Verible, to add Verible lint rules and waivers. Edalize has no flow API for Verible lint yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:systems:top_darjeeling:0.1
      - lowrisc:systems:top_darjeeling_pkg
      - lowrisc:systems:top_darjeeling_padring
      - lowrisc:virtual_systems:top_darjeeling_ast
      - lowrisc:virtual_systems:top_darjeeling_pad_orient_pkg
      - lowrisc:virtual_systems:top_darjeeling_scan_role_pkg
      # Which technology library resolves this is chosen by --mapping.
      - lowrisc:virtual_prim_tech:all
    files:
      - rtl/autogen/chip_darjeeling_asic.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/chip_darjeeling_asic.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

mapping:
  # The chip is what knows which analog top, pads, scan roles and JTAG ID it is
  # built with, so it owns their selection.  Apply them with
  # --mapping=lowrisc:systems:chip_darjeeling_asic:0.1; a partner supplies a core
  # declaring the same virtual VLNVs and maps that instead.
  "lowrisc:virtual_systems:top_darjeeling_ast": "lowrisc:systems:top_darjeeling_ast"
  "lowrisc:virtual_systems:top_darjeeling_pad_orient_pkg": "lowrisc:darjeeling_systems:pad_orient_pkg"
  "lowrisc:virtual_systems:top_darjeeling_scan_role_pkg": "lowrisc:darjeeling_systems:scan_role_pkg"
  "lowrisc:virtual_systems:top_darjeeling_physical_pads": "lowrisc:systems:top_darjeeling_physical_pads"
  "lowrisc:virtual_constants:top_darjeeling_jtag_id_pkg": "lowrisc:constants:top_darjeeling_jtag_id_pkg"

targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_veriblelint"
        add: [files_veriblelint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
      - files_rtl
    toplevel: chip_darjeeling_asic

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"
      # `slang_options` were CAPI=2's `tools: slang:`, used when this target ran with
      # `--tool=slang`. CAPI=3 has no `--tool`, so this Verilator build ignores them;
      # Edalize has no flow API for slang yet, so no CAPI=3 target can use them.
      slang_options:
        - "-Wno-port-coercion"

  syn:
    extends: default
    # TODO: set default to DC once
    # this option is available
    # olofk/edalize#89
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
    parameters:
      - SYNTHESIS=true
    toplevel: chip_darjeeling_asic

  formal:
    extends: default
    toplevel: chip_darjeeling_asic
    # CAPI=2 got the tool from dvsim's `--tool=icarus`
    # (hw/formal/tools/dvsim/common_formal_cfg.hjson), which a CAPI=3 core does
    # not take. Icarus only sets up the file list for the formal tool.
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
