CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:systems:chip_darjeeling_verilator:0.1"
description: "Darjeeling toplevel for simulation with Verilator"
filesets:
  files_sim_verilator:
    depend:
      - lowrisc:systems:top_darjeeling:0.1
      - lowrisc:systems:top_darjeeling_pkg
      - lowrisc:ibex:ibex_tracer
      - lowrisc:prim:clock_div
      - lowrisc:systems:top_darjeeling_ast
      - lowrisc:darjeeling_systems:pad_orient_pkg
      - lowrisc:darjeeling_systems:scan_role_pkg
      - lowrisc:prim_generic:all
    files:
      - rtl/padring_verilator.sv: { file_type: systemVerilogSource }
      - rtl/autogen/chip_darjeeling_verilator.sv: { file_type: systemVerilogSource }

parameters:
  AST_BYPASS_CLK:
    datatype: bool
    paramtype: vlogdefine

targets:
  default:
    filesets:
      - files_sim_verilator
    parameters:
      - AST_BYPASS_CLK=true
    toplevel: chip_darjeeling_verilator
    # CAPI=2 had these under `tools: verilator:`, applied only when the top level ran Verilator.
    # Flat `flow_options` reach every build, but only Verilator reads `verilator_options`.
    flow_options:
      verilator_options:
          # required to support OTP constants
        - "--max-num-width 131072"

  lint:
    extends: default
    vars: { tool_verilator: true }
    flow: lint
    flags: { tool: verilator }
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - inherit: default
        - "-Wall"
