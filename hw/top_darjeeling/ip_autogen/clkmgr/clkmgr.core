CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: lowrisc:darjeeling_ip:clkmgr:0.1
description: "Top specific clock manager "

vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:ip:lc_ctrl_pkg
      - lowrisc:darjeeling_ip:pwrmgr_pkg
      - lowrisc:ip:tlul
      - lowrisc:prim:all
      - lowrisc:prim:buf
      - lowrisc:prim:clock_buf
      - lowrisc:prim:clock_div
      - lowrisc:prim:clock_gating
      - lowrisc:prim:edge_detector
      - lowrisc:prim:lc_sync
      - lowrisc:prim:lc_sender
      - lowrisc:prim:measure
      - lowrisc:darjeeling_ip:clkmgr_pkg:0.1
      - lowrisc:darjeeling_ip:clkmgr_reg:0.1
    files:
      - rtl/clkmgr.sv
      - rtl/clkmgr_byp.sv
      - rtl/clkmgr_clk_status.sv
      - rtl/clkmgr_meas_chk.sv
      - rtl/clkmgr_root_ctrl.sv
      - rtl/clkmgr_trans.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/clkmgr.waiver
    file_type: waiver

  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
      - files_rtl
    toplevel: clkmgr

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"
