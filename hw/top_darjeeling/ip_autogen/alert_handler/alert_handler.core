name: lowrisc:darjeeling_ip:alert_handler:0.1
description: "Alert Handler"

filesets:
  files_rtl:
    depend:
      - lowrisc:darjeeling_ip:alert_handler_component:0.1
      - lowrisc:darjeeling_ip:alert_handler_reg:0.1
    file_type: systemVerilogSource

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine


targets:
  default:
    filesets:
      - files_rtl
    toplevel: alert_handler

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"
