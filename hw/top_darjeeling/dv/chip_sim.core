CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:dv:top_darjeeling_chip_sim:0.1"
description: "Darjeeling chip DV sim target"
vars:
  gatelevel:
    datatype: bool
    default: false
    description: Simulate the gate-level netlist instead of the RTL top level
  tool_veriblelint:
    datatype: bool
    default: false
    description: Set when linting with Verible, to add Verible lint rules and waivers. Edalize has no flow API for Verible lint yet, so no CAPI=3 target sets it

filesets:
  files_rtl:
    depend:
      - if: "!vars.gatelevel"
        add: [lowrisc:systems:top_darjeeling]
      - lowrisc:systems:top_darjeeling_pkg
      - if: "!vars.gatelevel"
        add: [lowrisc:systems:chip_darjeeling_asic]
      - lowrisc:ibex:ibex_tracer

  files_dv:
    depend:
      - lowrisc:ip:tlul
      - lowrisc:dv:top_darjeeling_chip_test
      - lowrisc:darjeeling_dv:clkmgr_sva
      - lowrisc:darjeeling_dv:pwrmgr_sva
      - lowrisc:darjeeling_dv:rstmgr_sva
      - lowrisc:darjeeling_dv:rv_core_ibex_sva
      - lowrisc:dv:top_darjeeling_sva
      - lowrisc:dv:top_darjeeling_xbar_dbg_bind
      - lowrisc:dv:top_darjeeling_xbar_main_bind
      - lowrisc:dv:top_darjeeling_xbar_peri_bind
      - lowrisc:dv:xbar_test
      - lowrisc:dv:xbar_macros
      - lowrisc:dv:sim_sram
      - lowrisc:dv:sw_test_status
      - lowrisc:dv:sw_logger_if
      - lowrisc:dv:mem_bkdr_util
      - lowrisc:dv:rom_ctrl_bkdr_util
      - lowrisc:dv:sram_ctrl_bkdr_util
    files:
      - tb/chip_hier_macros.svh: {is_include_file: true}
      - autogen/tb__xbar_connect.sv: {is_include_file: true}
      - autogen/xbar_env_pkg__params.sv: {is_include_file: true}
      - autogen/tb__alert_handler_connect.sv: {is_include_file: true}
      - tb/tb.sv
    file_type: systemVerilogSource

  files_veriblelint_waiver:
    files:
      - lint/chip_sim.vbw
    file_type: veribleLintWaiver

targets:
  default:
    toplevel: tb
    filesets:
      - if: "vars.tool_veriblelint"
        add: [files_veriblelint_waiver]
      - files_rtl
      - files_dv
    vars:
      chip_level: true
    flags:
      chip_level: true

  sim:
    extends: default
    flow_options:
      tool: vcs
    flow: sim
    flags: {tool: vcs}

  # Not converted: CAPI=3 has only the flow API, and Edalize 0.6.8
  # has no flow-API implementation of `veriblelint`. CAPI=2 ran this target
  # with dvsim's `--tool={tool}` (hw/lint/tools/dvsim/common_lint_cfg.hjson),
  # and OpenTitan's CI lints with Verible.
  # lint:
  #   extends: default
