CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: lowrisc:earlgrey_dv:alert_handler_sim:0.1
description: "ALERT_HANDLER DV sim target"
filesets:
  files_rtl:
    depend:
      - lowrisc:earlgrey_ip:alert_handler:0.1
    file_type: systemVerilogSource

  files_dv:
    depend:
      - lowrisc:earlgrey_dv:alert_handler_tb:0.1
      - lowrisc:earlgrey_dv:alert_handler_cov:0.1
      - lowrisc:earlgrey_dv:alert_handler_sva:0.1
    file_type: systemVerilogSource

generate:
  ral:
    generator: ralgen
    parameters:
      name: alert_handler
      ip_hjson: ../data/alert_handler.hjson
    position: prepend

targets:
  sim:
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    flow_options:
      tool: vcs
    flow: sim
    flags: {tool: vcs}

  # CAPI=2 ran this target with dvsim's `--tool={tool}`
  # (hw/lint/tools/dvsim/common_lint_cfg.hjson), which overrode the `vcs` it inherits.
  # OpenTitan's CI lints with Verible. A CAPI=3 core does not take `--tool`, and
  # Edalize has no flow API for Verible yet, so this target runs the `sim` flow
  # with vcs, not a lint.
  lint:
    extends: sim
