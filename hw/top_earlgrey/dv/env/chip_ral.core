name: "lowrisc:dv:top_earlgrey_chip_ral:0.1"
description: "UVM register model for the chip"

vars:
  skip_ral_gen:
    datatype: bool
    default: false
    description: Do not generate the chip RAL model

virtual:
  - lowrisc:dv:chip_ral

filesets:
  ral_dep:
    depend:
      - lowrisc:dv:ralgen
      - lowrisc:dv:dv_base_reg
      - if: "vars.skip_ral_gen"
        add: [partner:dv:chip_ast_ral_pkg]

generate:
  ral:
    generator: ralgen
    parameters:
      name: chip
      top_hjson: ../../data/top_earlgrey.hjson
    position: prepend

targets:
  default:
    filesets:
      - ral_dep
    generate:
      - if: "!vars.skip_ral_gen"
        add: [ral]
