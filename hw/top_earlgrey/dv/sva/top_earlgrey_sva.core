CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:dv:top_earlgrey_sva:0.1"
description: "TOP_EARLGREY assertion modules and bind file."
filesets:
  files_dv:
    depend:
      - lowrisc:earlgrey_ip:pwrmgr_pkg
      - lowrisc:prim:assert
      - lowrisc:systems:top_earlgrey
    files:
      - clk_ctrl_and_main_pd_sva_if.sv
      - top_earlgrey_bind.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
  formal:
    extends: default
    filesets:
      - files_dv
    toplevel: top_earlgrey_bind
    # CAPI=2 got the tool from dvsim's `--tool=icarus`
    # (hw/formal/tools/dvsim/common_formal_cfg.hjson), which a CAPI=3 core does
    # not take. Icarus only sets up the file list for the formal tool.
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
