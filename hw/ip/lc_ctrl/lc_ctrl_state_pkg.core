name: "lowrisc:ip:lc_ctrl_state_pkg:0.1"
description: "LC Controller State Package"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:util
    files:
      - rtl/lc_ctrl_state_pkg.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
    toplevel: lc_ctrl

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"
