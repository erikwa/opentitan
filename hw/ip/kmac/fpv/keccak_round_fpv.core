name: "lowrisc:fpv:keccak_round_fpv:0.1"
description: "Keccak_f FPV target"
filesets:
  files_formal:
    depend:
      - lowrisc:prim:all
      - lowrisc:ip:sha3
    files:
      - tb/keccak_round_fpv.sv
    file_type: systemVerilogSource

targets:
  default:
    # note, this setting is just used
    # to generate a file list for jg
    flow_options:
      tool: icarus
    # FUSESOC-MIGRATE: `icarus` is a flow-API tool of Edalize with no flow of its name, so it runs under `sim`, and the core file does not say whether this target simulates or lints. Keep `flow: sim` to simulate, or write `flow: lint` (specification §7.5)
    flow: sim
    flags: {tool: icarus}
    filesets:
      - files_formal
    toplevel:
      - keccak_round_fpv

  formal:
    extends: default
