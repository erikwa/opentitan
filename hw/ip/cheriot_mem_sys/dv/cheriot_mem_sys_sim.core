CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:dv:cheriot_mem_sys_sim:0.1"
description: "CHERIOT_MEM_SYS DV sim target"
filesets:
  files_rtl:
    depend:
      - lowrisc:ip:cheriot_mem_sys

  files_dv:
    depend:
      - lowrisc:dv:cheriot_mem_sys_test
      - lowrisc:dv:cheriot_mem_sys_sva
    files:
      - tb.sv
    file_type: systemVerilogSource

targets:
  sim:
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    flow_options:
      tool: vcs
    flow: sim
    flags: {tool: vcs}

  # TODO: add a lint check cfg in `hw/top_earlgrey/lint/top_earlgrey_dv_lint_cfgs.hjson`
  # CAPI=2 ran this target with dvsim's `--tool={tool}`
  # (hw/lint/tools/dvsim/common_lint_cfg.hjson), which overrode the `vcs` it inherits.
  # OpenTitan's CI lints with Verible. A CAPI=3 core does not take `--tool`, and
  # Edalize has no flow API for Verible yet, so this target runs the `sim` flow
  # with vcs, not a lint.
  lint:
    extends: sim
