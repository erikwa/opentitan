CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:ip:keymgr_dpe:0.1"
description: "Key Manager DPE"

vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:all
      - lowrisc:prim:count
      - lowrisc:prim:edn_req
      - lowrisc:prim:lc_sync
      - lowrisc:prim:lfsr
      - lowrisc:prim:msb_extend
      - lowrisc:prim:mubi
      - lowrisc:prim:sec_anchor
      - lowrisc:prim:secded
      - lowrisc:prim:sparse_fsm
      - lowrisc:ip:keymgr_dpe_pkg
      - lowrisc:ip:kmac_pkg
      - lowrisc:ip:lc_ctrl_pkg
      - lowrisc:ip:rom_ctrl_pkg
      - lowrisc:ip:tlul
    files:
      - rtl/keymgr_dpe.sv
      - rtl/keymgr_dpe_ctrl.sv
      - rtl/keymgr_dpe_cfg_en.sv
      - rtl/keymgr_dpe_reseed_ctrl.sv
      - rtl/keymgr_dpe_sideload_key.sv
      - rtl/keymgr_dpe_sideload_key_ctrl.sv
      - rtl/keymgr_dpe_data_en_state.sv
      - rtl/keymgr_dpe_kmac_if.sv
      - rtl/keymgr_dpe_input_checks.sv
      - rtl/keymgr_dpe_err.sv
      - rtl/keymgr_dpe_op_state_ctrl.sv
      - rtl/keymgr_dpe_reg_top.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/keymgr_dpe.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/keymgr_dpe.waiver
    file_type: waiver

  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine


targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
      - files_rtl
    toplevel: keymgr_dpe

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"

  syn:
    extends: default
    # TODO: set default to DC once
    # this option is available
    # olofk/edalize#89
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
    parameters:
      - SYNTHESIS=true

  formal:
    filesets:
      - files_rtl
    toplevel: keymgr_dpe_ctrl
    # CAPI=2 got the tool from dvsim's `--tool=icarus`
    # (hw/formal/tools/dvsim/common_formal_cfg.hjson), which a CAPI=3 core does
    # not take. Icarus only sets up the file list for the formal tool.
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
