CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:ip:pattgen:0.1"
description: "pattgen"
vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_veriblelint:
    datatype: bool
    default: false
    description: Set when linting with Verible, to add Verible lint rules and waivers. Edalize has no flow API for Verible lint yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim:all
      - lowrisc:ip:tlul
    files:
      - rtl/pattgen_reg_pkg.sv
      - rtl/pattgen_reg_top.sv
      - rtl/pattgen_ctrl_pkg.sv
      - rtl/pattgen_core.sv
      - rtl/pattgen_chan.sv
      - rtl/pattgen.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/pattgen.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/pattgen.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

#  No DV yet in this PR
#
#  files_formal:
#    files:
#      - dv/tb/pattgen_bind.sv
#    file_type: systemVerilogSource

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine


targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_veriblelint"
        add: [files_veriblelint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
#     files_formal yet undefined
#     - target_formal    ? (files_formal)
      - files_rtl
    toplevel: pattgen

#  files_formal yet undefined
#
#  formal:
#    filesets:
#      - files_rtl
#      - files_formal
#    toplevel: pattgen

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"
