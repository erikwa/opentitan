CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0

name: "lowrisc:dv:scramble_model"
description: "Memory scrambling C++ model"
filesets:
  files_cpp:
    depend:
      - lowrisc:dv:crypto_prince_ref
    files:
      - scramble_model.cc
      - scramble_model.h: { is_include_file: true }
    file_type: cppSource

targets:
  default:
    filesets:
      - files_cpp
    # CAPI=2 had these under `tools: vcs:`, applied only when the top level ran VCS.
    # Flat `flow_options` reach every build, but only VCS reads `vcs_options`.
    flow_options:
      vcs_options:
        - '-CFLAGS -I../../src/lowrisc_dv_scramble_model_0'
