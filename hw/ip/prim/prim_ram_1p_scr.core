name: "lowrisc:prim:ram_1p_scr:0.1"
description: "Single-port RAM primitive with data and address scrambling"
vars:
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim:util
      - lowrisc:prim:ram_1p_adv
      - lowrisc:prim:lfsr
      - lowrisc:prim:buf
      - lowrisc:prim:cipher
      - lowrisc:prim:util_get_scramble_params
    files:
      - rtl/prim_ram_1p_scr.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/prim_ram_1p_scr.vlt
    file_type: vlt

targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - files_rtl
