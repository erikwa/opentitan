CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:ip:otbn:0.1"
description: "OpenTitan Big Number Accelerator (OTBN)"

vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl_core:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim:util
      - lowrisc:prim:lfsr
      - lowrisc:prim:trivium
      - lowrisc:prim:cipher_pkg
      - lowrisc:prim:mubi
      - lowrisc:prim:crc32
      - lowrisc:prim:sparse_fsm
      - lowrisc:prim:onehot
      - lowrisc:prim:blanker
      - lowrisc:ip:keymgr_dpe_pkg
      - lowrisc:ip:edn_pkg
      - lowrisc:ip:otbn_pkg
      - lowrisc:prim:onehot_check
      - lowrisc:ip:kmac_pkg
      - lowrisc:ip:sha3
    files:
      - rtl/otbn_controller.sv
      - rtl/otbn_decoder.sv
      - rtl/otbn_predecode.sv
      - rtl/otbn_instruction_fetch.sv
      - rtl/otbn_rf_base.sv
      - rtl/otbn_rf_bignum.sv
      - rtl/otbn_rf_base_ff.sv
      - rtl/otbn_rf_bignum_ff.sv
      - rtl/otbn_rf_base_fpga.sv
      - rtl/otbn_rf_bignum_fpga.sv
      - rtl/otbn_lsu.sv
      - rtl/otbn_alu_base.sv
      - rtl/otbn_alu_bignum.sv
      - rtl/otbn_mac_bignum_fsm.sv
      - rtl/otbn_mac_bignum.sv
      - rtl/otbn_mai.sv
      - rtl/otbn_mask_accelerator.sv
      - rtl/otbn_kmac_if.sv
      - rtl/otbn_mod_result_selector.sv
      - rtl/otbn_loop_controller.sv
      - rtl/otbn_stack.sv
      - rtl/otbn_rnd.sv
      - rtl/otbn_sec_add.sv
      - rtl/otbn_sec_add_mod.sv
      - rtl/otbn_start_stop_control.sv
      - rtl/otbn_core.sv
      - rtl/otbn_vec_adder.sv
      - rtl/otbn_vec_multiplier.sv
      - rtl/otbn_vec_shifter.sv
      - rtl/otbn_vec_transposer.sv
    file_type: systemVerilogSource

  files_rtl_top:
    depend:
      - lowrisc:ip:tlul
      - lowrisc:prim:all
      - lowrisc:prim:assert
      - lowrisc:prim:util
      - lowrisc:prim:ram_1p_scr
      - lowrisc:prim:lc_sync
      - lowrisc:ip:edn_pkg
      - lowrisc:prim:edn_req
      - lowrisc:ip:otbn_pkg
      - lowrisc:ip:otp_ctrl_pkg
    files:
      - rtl/otbn_reg_top.sv
      - rtl/otbn_scramble_ctrl.sv
      - rtl/otbn.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/otbn.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/otbn.waiver
    file_type: waiver

  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
      - files_rtl_core
      - files_rtl_top
    toplevel: otbn

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"

  lint-core:
    filesets:
      - files_rtl_core
    toplevel: otbn_core
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"

  syn:
    extends: default
    # TODO: set default to DC once
    # this option is available
    # olofk/edalize#89
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
    parameters:
      - SYNTHESIS=true
