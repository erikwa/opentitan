CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:dv:usbdev_sim:0.1"
description: "USBDEV DV sim target"
filesets:
  files_rtl:
    depend:
      - lowrisc:ip:usbdev:0.1

  files_dv:
    depend:
      - lowrisc:dv:usbdev_test
      - lowrisc:dv:usbdev_sva
      - lowrisc:dv:usb20_usbdpi
      - lowrisc:dv_dpi_c:usbdpi
      - lowrisc:dv_dpi_sv:usbdpi
      - lowrisc:prim:usb_diff_rx
    files:
      - tb/tb.sv
    file_type: systemVerilogSource

targets:
  sim:
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    flow_options:
      tool: vcs
    flow: sim
    flags: {tool: vcs}

  # CAPI=2 ran this target with dvsim's `--tool={tool}`
  # (hw/lint/tools/dvsim/common_lint_cfg.hjson), which overrode the `vcs` it inherits.
  # OpenTitan's CI lints with Verible. A CAPI=3 core does not take `--tool`, and
  # Edalize has no flow API for Verible yet, so this target runs the `sim` flow
  # with vcs, not a lint.
  lint:
    extends: sim
