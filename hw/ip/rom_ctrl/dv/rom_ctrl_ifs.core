CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0

name: "lowrisc:dv:rom_ctrl_ifs:0.1"
description: "DV interfaces used in rom_ctrl tests"
filesets:
  files_dv:
    depend:
      - lowrisc:ip:rom_ctrl_pkg
      - lowrisc:ip:kmac_pkg
    files:
      - tb/rom_ctrl_if.sv
      - tb/rom_ctrl_bound_if.sv
      - tb/rom_ctrl_compare_if.sv
      - tb/rom_ctrl_compare_bound_if.sv
      - tb/rom_ctrl_fsm_if.sv
      - tb/rom_ctrl_fsm_bound_if.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
    flow_options:
      tool: vcs
    # FUSESOC-MIGRATE: `vcs` is a flow-API tool of Edalize with no flow of its name, so it runs under `sim`, and the core file does not say whether this target simulates or lints. Keep `flow: sim` to simulate, or write `flow: lint` (specification §7.5)
    flow: sim
    flags: {tool: vcs}

  # CAPI=2 ran this target with dvsim's `--tool={tool}`
  # (hw/lint/tools/dvsim/common_lint_cfg.hjson), which overrode the `vcs` it inherits.
  # OpenTitan's CI lints with Verible. A CAPI=3 core does not take `--tool`, and
  # Edalize has no flow API for Verible yet, so this target runs the `sim` flow
  # with vcs, not a lint.
  lint:
    extends: default
