CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:ip:rom_ctrl:0.1"
description: "ROM controller"

vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:alert
      - lowrisc:prim:assert
      - lowrisc:prim:buf
      - lowrisc:prim:cipher
      - lowrisc:prim:count
      - lowrisc:prim:rom_adv
      - lowrisc:prim:sec_anchor
      - lowrisc:prim:sparse_fsm
      - lowrisc:prim:subreg
      - lowrisc:prim:util
      - lowrisc:ip:kmac_pkg
      - lowrisc:ip:rom_ctrl_pkg
      - lowrisc:ip:tlul
    files:
      - rtl/rom_ctrl_regs_reg_top.sv
      - rtl/rom_ctrl.sv
      - rtl/rom_ctrl_compare.sv
      - rtl/rom_ctrl_counter.sv
      - rtl/rom_ctrl_fsm.sv
      - rtl/rom_ctrl_mux.sv
      - rtl/rom_ctrl_scrambled_rom.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/rom_ctrl.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/rom_ctrl.waiver
    file_type: waiver

  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
      - files_rtl
    toplevel: rom_ctrl

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"

  formal:
    filesets:
      - files_rtl
    toplevel: rom_ctrl_fsm
    # CAPI=2 got the tool from dvsim's `--tool=icarus`
    # (hw/formal/tools/dvsim/common_formal_cfg.hjson), which a CAPI=3 core does
    # not take. Icarus only sets up the file list for the formal tool.
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
