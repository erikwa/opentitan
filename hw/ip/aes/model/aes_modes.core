CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:model:aes_modes:0.6"
description: "AES Modes"
filesets:
  files_dv:
    files:
      - aes_modes.h: { is_include_file: true }
    file_type: cSource

targets:
  default:
    filesets:
      - files_dv

    # CAPI=2 had these under `tools: verilator:`, applied only when the top level ran Verilator.
    # Flat `flow_options` reach every build: only Verilator reads `verilator_options`,
    # but `mode` reaches any tool or flow with a `mode` option unless the top level
    # sets its own.
    flow_options:
      mode: cc
      verilator_options:
# linker flags
        - '-LDFLAGS "-pthread -lcrypto"'
