CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:ip:aes:1.0"
description: "AES unit"
vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_veriblelint:
    datatype: bool
    default: false
    description: Set when linting with Verible, to add Verible lint rules and waivers. Edalize has no flow API for Verible lint yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:all
      - lowrisc:prim:gf_mult
      - lowrisc:prim:lc_sync
      - lowrisc:prim:lfsr
      - lowrisc:prim:onehot
      - lowrisc:prim:sparse_fsm
      - lowrisc:prim:trivium
      - lowrisc:prim:util
      - lowrisc:ip:tlul
      - lowrisc:ip:lc_ctrl_pkg
      - lowrisc:ip:edn_pkg
      - lowrisc:ip:keymgr_dpe_pkg
    files:
      - rtl/aes_reg_pkg.sv
      - rtl/aes_pkg.sv
      - rtl/aes_reg_top.sv
      - rtl/aes_ctrl_reg_shadowed.sv
      - rtl/aes_ctrl_gcm_reg_shadowed.sv
      - rtl/aes_core.sv
      - rtl/aes_ctr.sv
      - rtl/aes_ctr_fsm.sv
      - rtl/aes_ctr_fsm_p.sv
      - rtl/aes_ctr_fsm_n.sv
      - rtl/aes_control.sv
      - rtl/aes_control_fsm.sv
      - rtl/aes_control_fsm_p.sv
      - rtl/aes_control_fsm_n.sv
      - rtl/aes_reg_status.sv
      - rtl/aes_sel_buf_chk.sv
      - rtl/aes_cipher_core.sv
      - rtl/aes_cipher_control.sv
      - rtl/aes_cipher_control_fsm.sv
      - rtl/aes_cipher_control_fsm_p.sv
      - rtl/aes_cipher_control_fsm_n.sv
      - rtl/aes_sub_bytes.sv
      - rtl/aes_sbox.sv
      - rtl/aes_sbox_lut.sv
      - rtl/aes_sbox_canright_pkg.sv
      - rtl/aes_sbox_canright.sv
      - rtl/aes_sbox_canright_masked_noreuse.sv
      - rtl/aes_sbox_canright_masked.sv
      - rtl/aes_sbox_dom.sv
      - rtl/aes_shift_rows.sv
      - rtl/aes_mix_columns.sv
      - rtl/aes_mix_single_column.sv
      - rtl/aes_key_expand.sv
      - rtl/aes_prng_clearing.sv
      - rtl/aes_prng_masking.sv
      - rtl/aes_ghash.sv
      - rtl/aes.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/aes.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/aes.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine


targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_veriblelint"
        add: [files_veriblelint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
      - files_rtl
    toplevel: aes

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"

  syn:
    extends: default
    # TODO: set default to DC once
    # this option is available
    # olofk/edalize#89
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
    parameters:
      - SYNTHESIS=true
