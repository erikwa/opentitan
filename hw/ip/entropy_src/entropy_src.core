CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:ip:entropy_src:0.1"
description: "entropy_src"
vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:virtual_constants:top_pkg
      - lowrisc:prim:all
      - lowrisc:prim:count
      - lowrisc:prim:edge_detector
      - lowrisc:prim:assert
      - lowrisc:prim:lfsr
      - lowrisc:prim:sparse_fsm
      - lowrisc:prim:macros
      - lowrisc:prim:max_tree
      - lowrisc:prim:sum_tree
      - lowrisc:prim:mubi
      - lowrisc:ip:tlul
      - lowrisc:ip:sha3
      - lowrisc:ip:entropy_src_pkg
      - lowrisc:ip:entropy_src_ack_sm_pkg
      - lowrisc:ip:entropy_src_main_sm_pkg
    files:
      - rtl/entropy_src_reg_pkg.sv
      - rtl/entropy_src_reg_top.sv
      - rtl/entropy_src_watermark_reg.sv
      - rtl/entropy_src_field_en.sv
      - rtl/entropy_src_cntr_reg.sv
      - rtl/entropy_src_ack_sm.sv
      - rtl/entropy_src_main_sm.sv
      - rtl/entropy_src_repcnt_ht.sv
      - rtl/entropy_src_repcnts_ht.sv
      - rtl/entropy_src_adaptp_ht.sv
      - rtl/entropy_src_adaptps_ht.sv
      - rtl/entropy_src_bucket_ht.sv
      - rtl/entropy_src_markov_ht.sv
      - rtl/entropy_src_enable_delay.sv
      - rtl/entropy_src_core.sv
      - rtl/entropy_src.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/entropy_src.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/entropy_src.waiver
    file_type: waiver


  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine


targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
      - files_rtl
    toplevel: entropy_src

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"
