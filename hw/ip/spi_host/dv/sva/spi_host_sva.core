CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:dv:spi_host_sva:0.1"
description: "SPI_HOST assertion modules and bind file."
filesets:
  files_dv:
    depend:
      - lowrisc:tlul:headers
      - lowrisc:fpv:csr_assert_gen
      - lowrisc:ip:spi_host
      - lowrisc:dv:spi_host_env_cfg_pkg
    files:
      - spi_host_data_stable_sva.sv
      - spi_host_bind.sv
    file_type: systemVerilogSource


generate:
  csr_assert_gen:
    generator: csr_assert_gen
    parameters:
      spec: ../../data/spi_host.hjson

targets:
  default:
    filesets:
      - files_dv
    generate:
      - csr_assert_gen

  formal:
    extends: default
    filesets:
      - files_formal
      - files_dv
    toplevel: spi_host
    # CAPI=2 got the tool from dvsim's `--tool=icarus`
    # (hw/formal/tools/dvsim/common_formal_cfg.hjson), which a CAPI=3 core does
    # not take. Icarus only sets up the file list for the formal tool.
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
