CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:lint:common:0.1"
description: "Common waivers"
vars:
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_veriblelint:
    datatype: bool
    default: false
    description: Set when linting with Verible, to add Verible lint rules and waivers. Edalize has no flow API for Verible lint yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_verilator:
    files:
      - tools/verilator/common.vlt
    file_type: vlt

  files_ascentlint:
    files:
      - tools/ascentlint/common.waiver: {file_type: waiver}
      - tools/ascentlint/ascentlint-config.tcl: {file_type: tclSource}

  files_veriblelint:
    files:
      - tools/veriblelint/lowrisc-styleguide.rules.verible_lint: {file_type: veribleLintRules}
      - tools/veriblelint/common.vbl: {file_type: veribleLintWaiver}

  files_check_tool_requirements:
    depend:
     - lowrisc:tool:check_tool_requirements

targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint]
      - if: "vars.tool_veriblelint"
        add: [files_veriblelint]
      - files_check_tool_requirements
    # Not converted: CAPI=3 has only the flow API, and Edalize 0.6.8
    # has no flow-API implementation of `ascentlint` or `slang`.
    # tools:
    #   ascentlint:
    #     ascentlint_options:
    #       - "-wait_license"
    #       - "-stop_on_error"
    #   slang:
    #     slang_options:
    #       - "-Wpedantic"
    #       - "-Werror"
    #       - "--allow-use-before-declare"
    #       - "--single-unit"
    #       - "--error-limit 0"
