name: "lowrisc:ibex:ibex_formal:0.1"
description: "Ibex formal module used to prove equivalence with Sail"

vars:
  fileset_partner:
    datatype: bool
    default: false
    description: Use the partner primitive library instead of the generic one

filesets:
  files_rtl:
    depend:
      - lowrisc:ibex:ibex_pkg
      - lowrisc:ibex:ibex_core
      - lowrisc:ibex:ibex_top
      - if: "vars.fileset_partner"
        add: [partner:prim_generic:all]
      - if: "!vars.fileset_partner"
        add: [lowrisc:prim_generic:all]

targets:
  default:
    filesets:
      - files_rtl
    toplevel: ibex_top
