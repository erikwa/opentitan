name: "lowrisc:ibex:ibex_icache:0.1"
description: "Ibex instruction cache"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:secded
      - lowrisc:prim:assert
      - lowrisc:ibex:ibex_pkg
    files:
      - rtl/ibex_icache.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
    toplevel: ibex_icache
    flow_options:
      tool: vcs
    # FUSESOC-MIGRATE: `vcs` is a flow-API tool of Edalize with no flow of its name, so it runs under `sim`, and the core file does not say whether this target simulates or lints. Keep `flow: sim` to simulate, or write `flow: lint` (specification §7.5)
    flow: sim
    flags: {tool: vcs}
