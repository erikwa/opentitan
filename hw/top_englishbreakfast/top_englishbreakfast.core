CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:systems:top_englishbreakfast:0.1"
description: "Technology-independent English Breakfast toplevel"
vars:
  fileset_tapeout:
    datatype: bool
    default: false
    description: Use the tapeout RTL files instead of the testing files
  tool_ascentlint:
    datatype: bool
    default: false
    description: Set when linting with AscentLint, to add AscentLint waivers. Edalize has no flow API for AscentLint yet, so no CAPI=3 target sets it
  tool_slang:
    datatype: bool
    default: false
    description: Set when linting with slang, to add slang waivers. Edalize has no flow API for slang yet, so no CAPI=3 target sets it
  tool_veriblelint:
    datatype: bool
    default: false
    description: Set when linting with Verible, to add Verible lint rules and waivers. Edalize has no flow API for Verible lint yet, so no CAPI=3 target sets it
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl_generic:
    depend:
      - lowrisc:englishbreakfast_ip:pwrmgr_pkg
      - lowrisc:earlgrey_ip:alert_handler_pkg
      - lowrisc:systems:top_englishbreakfast_ast_pkg
      - lowrisc:englishbreakfast_constants:top_racl_pkg
      # Manually instantiated
      - lowrisc:ip:rv_dm
      - lowrisc:ip:tlul
      - lowrisc:prim:all
      - lowrisc:prim:ram_1p_adv
      - lowrisc:prim:ram_1p_scr
      - lowrisc:prim:flash
      - lowrisc:ip:sram_ctrl
      # Instantiated by topgen
      - lowrisc:ip:uart:0.1
      - lowrisc:ip:rv_timer
      - lowrisc:ip:spi_device
      - lowrisc:ip:spi_host
      - lowrisc:ip:aes
      - lowrisc:ip:entropy_src
      - lowrisc:ip:hmac
      - lowrisc:ip:kmac
      - lowrisc:ip:keymgr_dpe_pkg
      - lowrisc:ip:lc_ctrl
      - lowrisc:ip:usbdev
      - lowrisc:top_englishbreakfast:xbar_main
      - lowrisc:top_englishbreakfast:xbar_peri
      - lowrisc:englishbreakfast_ip:clkmgr
      - lowrisc:englishbreakfast_ip:flash_ctrl
      - lowrisc:englishbreakfast_ip:pinmux
      - lowrisc:englishbreakfast_ip:pwrmgr
      - lowrisc:englishbreakfast_ip:rstmgr
      - lowrisc:englishbreakfast_ip:rv_plic
      - lowrisc:englishbreakfast_ip:gpio
      - lowrisc:englishbreakfast_ip:rv_core_ibex
      - lowrisc:ip:rom_ctrl
      - lowrisc:ip:aon_timer
      - lowrisc:tlul:headers
      - lowrisc:systems:top_englishbreakfast_pkg
      - lowrisc:englishbreakfast_constants:top_pkg
    files:
      - rtl/autogen/top_englishbreakfast.sv
      - rtl/autogen/englishbreakfast_pd_main.sv
      - rtl/autogen/englishbreakfast_pd_aon.sv
    file_type: systemVerilogSource

  files_rtl_testing:
    depend:
      - lowrisc:englishbreakfast_constants:testing_rnd_cnst_pkg

  files_rtl_tapeout:
    depend:
      - lowrisc:englishbreakfast_constants:prod_rnd_cnst_pkg

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_englishbreakfast.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_englishbreakfast.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_englishbreakfast.vbl
    file_type: veribleLintWaiver


  files_slang_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine


targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - if: "vars.tool_ascentlint"
        add: [files_ascentlint_waiver]
      - if: "vars.tool_veriblelint"
        add: [files_veriblelint_waiver]
      - if: "vars.tool_slang"
        add: [files_slang_waiver]
      - if: "vars.fileset_tapeout"
        add: [files_rtl_tapeout]
      - if: "!vars.fileset_tapeout"
        add: [files_rtl_testing]
      - files_rtl_generic
    toplevel: top_englishbreakfast

  sim:
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
    filesets:
      - if: "vars.fileset_tapeout"
        add: [files_rtl_tapeout]
      - if: "!vars.fileset_tapeout"
        add: [files_rtl_testing]
      - files_rtl_generic
    toplevel: top_englishbreakfast

  lint:
    extends: default
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    parameters:
      - SYNTHESIS=true
    flow_options:
      tool: verilator
      mode: lint-only
      verilator_options:
        - "-Wall"
