CAPI=3:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: lowrisc:englishbreakfast_dv:rstmgr_sva:0.1
description: "RSTMGR assertion modules and bind file."
filesets:
  files_dv:
    depend:
      - lowrisc:prim:mubi
      - lowrisc:englishbreakfast_ip:rstmgr_pkg:0.1
      - lowrisc:fpv:csr_assert_gen
      - lowrisc:englishbreakfast_dv:rstmgr_sva_ifs:0.1

    files:
      - rstmgr_bind.sv
    file_type: systemVerilogSource

generate:
  csr_assert_gen:
    generator: csr_assert_gen
    parameters:
      spec: ../../data/rstmgr.hjson

targets:
  default:
    filesets:
      - files_dv
    generate:
      - csr_assert_gen
  formal:
    extends: default
    filesets:
      - files_dv
    toplevel: rstmgr
    # CAPI=2 got the tool from dvsim's `--tool=icarus`
    # (hw/formal/tools/dvsim/common_formal_cfg.hjson), which a CAPI=3 core does
    # not take. Icarus only sets up the file list for the formal tool.
    flow_options:
      tool: icarus
    flow: sim
    flags: {tool: icarus}
