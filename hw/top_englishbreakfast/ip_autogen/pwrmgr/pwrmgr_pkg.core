name: lowrisc:englishbreakfast_ip:pwrmgr_pkg:0.1
description: "Power manager package"

vars:
  tool_verilator:
    datatype: bool
    default: false
    description: Set by top-level targets that build with Verilator, to add Verilator waivers and checks

filesets:
  files_rtl:
    depend:
      - lowrisc:tlul:headers
    files:
      - rtl/pwrmgr_reg_pkg.sv
      - rtl/pwrmgr_pkg.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/pwrmgr_pkg.vlt
    file_type: vlt

targets:
  default:
    filesets:
      - if: "vars.tool_verilator"
        add: [files_verilator_waiver]
      - files_rtl
